<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/_10sdp"

    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/episode_background"
        android:padding="@dimen/_15sdp">

        <androidx.cardview.widget.CardView
            android:id="@+id/imgPayCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/whiteMy"
            android:layout_centerVertical="true"

            app:cardCornerRadius="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <ImageView
                android:id="@+id/imgPay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_stripe_rounded" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/name"
            style="@style/BodyLargeBold"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/selected"
            android:layout_toEndOf="@+id/imgPayCardView"
            android:layout_weight="1"
            android:drawablePadding="@dimen/_5sdp"
            android:text="Weekly VIP"
            android:textStyle="bold"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/whiteMy" />

