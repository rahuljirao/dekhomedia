                android:textSize="@dimen/_10sdp"
                app:layout_constraintBottom_toTopOf="@+id/tvMethod"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Text: Paytm -->
            <TextView
                android:id="@+id/tvMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Pay"
                android:textColor="@color/whiteMy"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tvPayVia"
                app:layout_constraintTop_toBottomOf="@+id/tvPayVia" />

            <!-- Dropdown Icon -->
            <ImageView
                android:id="@+id/imgArrow"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_bottom"
                app:layout_constraintBottom_toBottomOf="@id/tvMethod"
                app:layout_constraintStart_toEndOf="@id/tvMethod"
                app:layout_constraintTop_toTopOf="@+id/tvMethod" />


        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- Pay Button -->
        <TextView
