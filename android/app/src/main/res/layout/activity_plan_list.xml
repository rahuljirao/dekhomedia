    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/onPlayll"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/shap_rectangle_top"
        android:backgroundTint="@color/cardview_dark_background"
        android:elevation="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_15sdp">

        <!-- Paytm Icon -->

        <androidx.cardview.widget.CardView
            android:id="@+id/imgPayCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/whiteMy"
            app:cardCornerRadius="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <ImageView
                android:id="@+id/imgPay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_stripe_rounded" />
        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/paymentConstraint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/imgPayCardView"
            app:layout_constraintStart_toEndOf="@+id/imgPayCardView"
            app:layout_constraintTop_toTopOf="@+id/imgPayCardView">
            <!-- Text: Pay via -->
            <TextView
